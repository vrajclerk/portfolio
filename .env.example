# =============================================================================
# .env.example — Required environment variables
# =============================================================================
#
# Copy this file to .env.local for local development.
# Real .env files are excluded from Git by .gitignore.
# Never commit real secrets, credentials, or connection strings.
#
# See README.md for setup instructions.
# =============================================================================

# -----------------------------------------------------------------------------
# Public variables (exposed to the browser via NEXT_PUBLIC_ prefix)
# -----------------------------------------------------------------------------

# Canonical public URL of the deployed site.
# Used for Open Graph metadata, canonical tags, sitemap, and RSS feed URLs.
# Example: https://yourname.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Server-side secrets (Phase 2 — not required until Payload CMS is installed)
# -----------------------------------------------------------------------------

# Payload CMS secret key — must be a long, random string (32+ characters).
# Generate with: openssl rand -base64 32
# Required in Phase 2+.
PAYLOAD_SECRET=replace_with_a_long_random_string

# PostgreSQL connection string for the Neon database.
# Neon provides a pooled connection URL in the project dashboard.
# Format: postgresql://user:password@host/dbname?sslmode=require
# Required in Phase 2+.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# -----------------------------------------------------------------------------
# Contact form (Phase 4 — not required until contact form is implemented)
# -----------------------------------------------------------------------------

# Gmail SMTP credentials for contact form delivery (D7).
# Requires a Gmail App Password (Google Account > Security > App Passwords).
# Do NOT use your Google account password here.
# SMTP_FROM_ADDRESS=your-address@gmail.com
# SMTP_PASS=your_gmail_app_password_here

# -----------------------------------------------------------------------------
# Vercel Blob (Phase 2 — required for media uploads in the deployed environment)
# -----------------------------------------------------------------------------

# Automatically injected by Vercel when Blob is connected in the Vercel dashboard.
# Set manually for local development only if testing media uploads locally.
# BLOB_READ_WRITE_TOKEN=vercel_blob_replace_with_token_from_vercel_dashboard
